# Copy this file to `.env` (gitignored) and fill in your real keys.

# ============================================================
# Local Ollama (free, for non-critical iterations)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_REASONING_MODEL=deepseek-r1:14b

# RD-Agent-style LiteLLM wrapper around Ollama
CHAT_MODEL=ollama/qwen2.5-coder:14b
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama   # Ollama doesn't check, but LiteLLM requires non-empty

# ============================================================
# DeepSeek API (for final-pass tuning + LLM industry picker).
# Get a key at https://platform.deepseek.com/
# ============================================================
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# When you want the project to use DeepSeek as the primary chat backend:
# CHAT_MODEL=deepseek/deepseek-chat

# ============================================================
# Qlib data paths
# ============================================================
QLIB_PROVIDER_URI=D:/PM/jr/qlib_data/cn_data
QLIB_REGION=cn

# ============================================================
# Time segments: train 2018-2024 / valid 2024-2025 / test 2025-2026
# ============================================================
QLIB_FACTOR_TRAIN_START=2018-01-02
QLIB_FACTOR_TRAIN_END=2024-06-30
QLIB_FACTOR_VALID_START=2024-07-01
QLIB_FACTOR_VALID_END=2025-06-30
QLIB_FACTOR_TEST_START=2025-07-01
QLIB_FACTOR_TEST_END=2026-05-13

QLIB_MODEL_TRAIN_START=2018-01-02
QLIB_MODEL_TRAIN_END=2024-06-30
QLIB_MODEL_VALID_START=2024-07-01
QLIB_MODEL_VALID_END=2025-06-30
QLIB_MODEL_TEST_START=2025-07-01
QLIB_MODEL_TEST_END=2026-05-13

# RD-Agent evolution rounds (2-3 to validate, 10+ for real runs)
QLIB_FACTOR_EVOLVING_N=2
QLIB_MODEL_EVOLVING_N=2

# ============================================================
# Bypass system Clash proxy for domestic APIs
# ============================================================
NO_PROXY=*
